# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# From https://resend.com/api-keys (free tier is fine to start)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions get sent — your real Gmail address
CONTACT_TO_EMAIL=you@gmail.com

# The "from" address Resend sends as. Until you verify your own domain on Resend,
# use onboarding@resend.dev — it works immediately with no setup.
CONTACT_FROM_EMAIL=onboarding@resend.dev
